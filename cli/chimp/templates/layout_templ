package templates

import (
	"github.com/s00500/chimp"
	"github.com/s00500/chimp/components"
)

var CacheBust = false

templ Layout() {
	<html class="dark">
		<head>
			@chimp.Base()
			@chimp.IncludedDatastarRocket()
			@chimp.StyleWithCacheBust("static/style.css", CacheBust)
			<title>{{ .ProjectName }}</title>
		</head>
		//<body data-init={ "@post('events')" }> // use on-load to create a subscription like sse event stream
		<body>
			@components.NotificationContainer()
			@components.ConfirmModal("")
			<div id="wrapper" class="m-4 grid grid-cols-3 gap-4">
				{ children... }
			</div>
			@chimp.HotReload(CacheBust)
		</body>
	</html>
}

